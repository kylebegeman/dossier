{
  "name": "@kylebegeman/dossier-react",
  "version": "0.7.0",
  "description": "A typed React wrapper around the self-contained HTML artifact Dossier renders.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "pack:check": "npm pack --dry-run --json"
  },
  "peerDependencies": {
    "@kylebegeman/dossier": ">=0.7.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@kylebegeman/dossier": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
