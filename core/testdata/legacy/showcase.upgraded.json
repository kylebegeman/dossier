          "type": "code",
          "title": "render.ts",
          "lang": "ts",
          "code": "import { renderDossier } from \"@kylebegeman/dossier-react\";\nconst { html, md } = await renderDossier(model); // one self-contained file"
        },
        {
          "type": "prose",
          "markdown": "### Shell"
        },
        {
          "type": "code",
          "lang": "bash",
          "code": "dossier init my-doc\ndossier build my-doc.dossier.json && open my-doc.html"
        },
