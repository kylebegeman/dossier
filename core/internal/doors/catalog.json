{
  "schema_version": "dossier.doors/v1",
  "commands": [
    {
      "id": "describe",
      "summary": "List the commands and the kinds with their facet vocabularies.",
      "mutation": "read-only",
      "surfaces": ["cli", "mcp", "skill"],
      "parameters": { "type": "object", "additionalProperties": false, "properties": {} }
    },
    {
      "id": "validate",
      "summary": "Check model files against the schema, the structure rules, and their kind.",
      "mutation": "read-only",
      "surfaces": ["cli", "mcp", "skill"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["files"],
        "properties": { "files": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
      }
    },
    {
      "id": "decisions.read",
      "summary": "Read a model's decisions as a decisions document, optionally writing it to a file.",
      "mutation": "read-only",
      "surfaces": ["cli", "mcp", "skill"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model"],
        "properties": {
          "model": { "type": "string" },
          "out": { "type": "string", "description": "Write the decisions document here, .md or .json." }
        }
      }
    },
    {
      "id": "decisions.apply",
      "summary": "Apply a reply line or a decisions document to a model and write the model back.",
      "mutation": "writes-files",
      "surfaces": ["cli", "mcp", "skill"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model"],
        "properties": {
          "model": { "type": "string" },
          "reply": { "type": "string", "description": "A reply line such as \"rebuild, 1, 3. Notes: 3: keep blue.\"" },
          "from": { "type": "string", "description": "A decisions document, .md or .json." },
          "out": { "type": "string", "description": "Write the updated model here instead of in place." },
          "decisions": { "type": "string", "description": "Also write the decisions document here." }
        }
      }
    },
    {
      "id": "build",
      "summary": "Render model files to self-contained HTML beside each source or into --out.",
      "mutation": "writes-files",
      "surfaces": ["cli", "mcp", "skill"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["files"],
        "properties": {
          "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "out": { "type": "string", "description": "Directory for the HTML output." }
        }
      }
    }
  ]
}
