package render

import "strconv"

templ document(p *Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="generator" content="dossier"/>
			<title>{ p.Doc.Meta.Title }</title>
			if p.Fonts {
				<link rel="preconnect" href="https://fonts.googleapis.com"/>
				<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Instrument+Serif:ital@1&family=JetBrains+Mono:wght@400;500&display=swap"/>
			}
			@templ.Raw(p.StyleHTML)
		</head>
		<body>
			<div class="page">
				@masthead(p)
				@contentsNav(p)
				<main class="main" id="main">
					<p class="no-hits" data-no-hits hidden>Nothing in this document matches <b data-no-hits-query></b>. <button class="link-btn" type="button" data-search-clear>Clear the search</button></p>
					for _, s := range p.Sections {
						@section(p, s)
					}
					if p.Decides {
						@pick(p)
					}
				</main>
				<footer class="foot">
					<span>{ p.Doc.Meta.Title }</span>
					<span>Generated with Dossier{ updatedSuffix(p) }</span>
				</footer>
			</div>
			<div class="toast" role="status" aria-live="polite" data-toast></div>
			@templ.Raw(p.ModelScriptHTML)
			if p.StudioHTML != "" {
				@templ.Raw(p.StudioHTML)
			}
			@templ.Raw(p.ReaderScriptHTML)
		</body>
	</html>
}

// cellOf returns an item's summary cell for a field, empty when unset.
func cellOf(it ItemView, name string) Cell { return it.Cells[name] }

// entryNumber is a contents entry's marker: its number, or a dash.
func entryNumber(e TocEntry) string {
	if e.Number == 0 {
		return "–"
	}
	return strconv.Itoa(e.Number) + "."
}

// itemAttrs carries what the reader runtime needs on an item: its number,
// whether the reader can decide on it, and the tone of its verdict.
func itemAttrs(it ItemView) templ.Attributes {
	a := templ.Attributes{}
	if it.Numbered {
		a["data-num"] = strconv.Itoa(it.Number)
	}
	if it.Decides {
		a["data-decides"] = true
	}
	if it.Tone != "" {
		a["data-tone"] = it.Tone
	}
	return a
}

// toneAttr sets data-tone only when there is a tone.
func toneAttr(tone string) templ.Attributes {
	if tone == "" {
		return nil
	}
	return templ.Attributes{"data-tone": tone}
}

func tabIndex(focus bool) string {
	if focus {
		return "0"
	}
	return "-1"
}

// edit marks a field the serve studio can edit. Artifacts pass no target,
// which renders no attribute.
func edit(target string) templ.Attributes {
	if target == "" {
		return nil
	}
	return templ.Attributes{"data-edit": target}
}

func updatedSuffix(p *Page) string {
	if p.Doc.Meta.Updated == "" {
		return ""
	}
	return " · " + p.Doc.Meta.Updated
}

templ masthead(p *Page) {
	<header class="masthead">
		<div class="mast-top">
			if p.Doc.Meta.Kicker != "" {
				<p class="kicker" { edit(p.EditKicker)... }>{ p.Doc.Meta.Kicker }</p>
			} else {
				<span></span>
			}
			<div class="tools">
				<label class="search">
					<span class="sr">Search this document</span>
					<input type="search" placeholder="Search" autocomplete="off" spellcheck="false" data-search/>
					<kbd aria-hidden="true">/</kbd>
				</label>
				<span class="hits" data-hits aria-live="polite"></span>
				if p.Decides {
					<button class="btn" type="button" data-hide aria-pressed="false">Hide decided</button>
				}
				if p.HasArticles {
					<button class="btn" type="button" data-collapse-toggle aria-expanded="false">Expand all</button>
				}
				@themeToggle()
			</div>
		</div>
		<h1 { edit(p.EditTitle)... }>@templ.Raw(p.TitleHTML)</h1>
		if p.Doc.Meta.Lede != "" {
			<p class="lede" { edit(p.EditLede)... }>{ p.Doc.Meta.Lede }</p>
		}
		if len(p.Facts) > 0 {
			<div class="stats" aria-label="At a glance">
				for _, f := range p.Facts {
					<div class={ templ.KV("live", f.Live != ""), templ.KV("t-"+f.Tone, f.Tone != "") }>
						if f.Live != "" {
							<b data-live={ f.Live }>{ f.Value }</b>
						} else {
							<b>{ f.Value }</b>
						}
						if f.Live == "choice" {
							<a href="#pick">{ f.Label }</a>
						} else {
							<span>{ f.Label }</span>
						}
					</div>
				}
			</div>
		}
	</header>
}

templ themeToggle() {
	<button class="btn theme-toggle" type="button" data-theme-toggle data-mode="auto" aria-label="Theme: auto, follows your system">
		<svg class="th-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17A8.5 8.5 0 0 0 12 3.5Z" fill="currentColor" stroke="none"></path></svg>
		<svg class="th-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" hidden><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7"></path></svg>
		<svg class="th-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" hidden><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path></svg>
		<span class="th-label">Auto</span>
	</button>
}

templ contentsNav(p *Page) {
	<nav class="toc" aria-label="Contents">
		<ol>
			for _, g := range p.Contents {
				<li class="group">{ g.Label }</li>
				for _, e := range g.Entries {
					if e.Item {
						<li data-item={ e.ID } class={ templ.KV("picked", e.Picked) } { toneAttr(e.Tone)... }><a href={ templ.URL("#" + e.ID) }><span class="n">{ entryNumber(e) }</span>{ e.Label }<span class="sr">{ e.Decided }</span><span class="pip" aria-hidden="true"></span></a></li>
					} else {
						<li><a href={ templ.URL("#" + e.ID) }><span class="n">–</span>{ e.Label }</a></li>
					}
				}
			}
		</ol>
	</nav>
}

templ section(p *Page, s SectionView) {
	<section class="section" id={ s.ID }>
		<h2 { edit(s.EditTitle)... }>{ s.Title }</h2>
		for _, part := range s.Parts {
			@partView(part)
		}
		if s.Board != nil {
			if s.Board.Rows {
				@rowsBoard(s.Board)
			} else {
				if s.Board.Summary {
					@summaryTable(p, s.Board)
				}
				for _, it := range s.Board.Items {
					@itemArticle(it)
				}
				<div class="hidden-row" data-hidden-row hidden>
					<span><b data-hidden-count>0</b> hidden</span>
					<button class="btn" type="button" data-show-all>Show all</button>
				</div>
			}
		}
	</section>
}

templ partView(part PartView) {
	switch part.Type {
		case "prose":
			<div class="part prose" { edit(part.Edit)... }>
				@templ.Raw(part.HTML)
			</div>
		case "callout":
			<div class={ "part callout", templ.KV("risk", part.Tone == "risk") }>
				if part.Title != "" {
					<b>{ part.Title }</b>
				}
				<div { edit(part.Edit)... }>
					@templ.Raw(part.HTML)
				</div>
			</div>
		case "spec":
			<div class="part spec">
				for _, r := range part.Spec {
					<div><b>{ r.Label }</b><span>@templ.Raw(r.Text)</span></div>
				}
			</div>
		case "table":
			<div class="part table-wrap">
				<table>
					<thead>
						<tr>
							for _, c := range part.Columns {
								<th>{ c }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, row := range part.Rows {
							<tr>
								for _, cell := range row {
									<td>@templ.Raw(cell)</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
			if part.Note != "" {
				<p class="legend">{ part.Note }</p>
			}
		case "code":
			<div class="part block">
				if part.Title != "" {
					<div class="block-label"><span>{ part.Title }</span></div>
				}
				<pre class="hl"><code>@templ.Raw(part.HTML)</code></pre>
			</div>
		case "figure":
			<figure class="part figure">
				<img src={ part.Src } alt={ part.Alt } loading="lazy"/>
				if part.Caption != "" {
					<figcaption class="legend">@templ.Raw(part.Caption)</figcaption>
				}
			</figure>
		case "diagram":
			<div class="part block diagram" data-format={ part.Format }>
				<div class="block-label">
					<span>{ part.Format }</span>
					if part.Title != "" {
						<span>{ part.Title }</span>
					}
				</div>
				<pre><code>{ part.Code }</code></pre>
			</div>
		case "chart":
			<div class="part block chart">
				if part.Title != "" {
					<div class="block-label"><span>{ part.Title }</span></div>
				}
				@templ.Raw(part.SVG)
			</div>
	}
}

templ summaryTable(p *Page, b *BoardView) {
	<div class="part table-wrap">
		<table>
			<thead>
				<tr>
					for _, c := range b.Columns {
						@summaryHeader(c)
					}
				</tr>
			</thead>
			<tbody>
				for _, it := range b.Items {
					<tr data-item={ it.ID } class={ templ.KV("picked", it.Picked) } { toneAttr(it.Tone)... }>
						for _, c := range b.Columns {
							@summaryCell(c, it)
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
	if b.Legend != "" {
		<p class="legend">{ b.Legend }</p>
	}
}

templ summaryHeader(c Column) {
	switch c.Name {
		case "number":
			<th class="num">#</th>
		case "decision":
			if c.Header == "Pick" {
				<th class="ck"><span class="sr">{ c.Header }</span></th>
			} else {
				<th class="vd">{ c.Header }</th>
			}
		default:
			<th>{ c.Header }</th>
	}
}

templ summaryCell(c Column, it ItemView) {
	switch c.Name {
		case "number":
			<td class="num">{ strconv.Itoa(it.Number) }</td>
		case "title":
			<td><a href={ templ.URL("#" + it.ID) }>{ it.Title }</a></td>
		case "decision":
			if it.Pickable {
				<td class="ck"><input class="check" type="checkbox" data-pick-row={ it.ID } aria-label={ "Pick " + strconv.Itoa(it.Number) + ", " + it.Title } checked?={ it.Picked }/></td>
			} else if it.Decides {
				<td class="vd">
					<select class="verdict" data-verdict-row={ it.ID } aria-label={ "Verdict on " + strconv.Itoa(it.Number) + ", " + it.Title }>
						<option value="">Undecided</option>
						for _, v := range it.Verdicts {
							<option value={ v.ID } selected?={ v.Checked }>{ v.Label }</option>
						}
					</select>
				</td>
			} else {
				<td class="vd"><span class="none">No verdict needed</span></td>
			}
		case "impact":
			<td>
				if it.Impact > 0 {
					@meter(it.Impact, it.ImpactMax)
				}
			</td>
		case "dependsOn":
			<td>
				<span class="deps">
					if len(it.DependsOn) == 0 {
						nothing
					}
					for i, d := range it.DependsOn {
						if i > 0 {
							,
						}
						<a href={ templ.URL("#" + d.ID) } title={ d.Title }>{ strconv.Itoa(d.Number) }</a>
					}
				</span>
			</td>
		default:
			<td>
				if cellOf(it, c.Name).Chip {
					<span class={ "chip", "t-" + cellOf(it, c.Name).Tone }>{ cellOf(it, c.Name).Text }</span>
				} else {
					{ cellOf(it, c.Name).Text }
				}
			</td>
	}
}

templ meter(value int, max int) {
	<span class="meter" aria-label={ "Impact " + strconv.Itoa(value) + " of " + strconv.Itoa(max) }>
		for i := 1; i <= max; i++ {
			<i class={ templ.KV("on", i <= value) }></i>
		}
	</span>
}

templ itemArticle(it ItemView) {
	<details class={ "item", templ.KV("picked", it.Picked) } id={ it.ID } data-item={ it.ID } data-title={ it.Title } { itemAttrs(it)... }>
		<summary class="item-head">
			<div class="item-meta">
				for _, c := range it.Chips {
					@chip(c)
				}
				if it.Impact > 0 {
					@meter(it.Impact, it.ImpactMax)
					<span class="meter-label">{ it.ImpactLabel } { strconv.Itoa(it.Impact) }/{ strconv.Itoa(it.ImpactMax) }</span>
				}
				if it.Notes {
					<span class="decide">
						if len(it.Verdicts) > 0 {
							<span class="verdicts" role="radiogroup" aria-label={ "Verdict on " + strconv.Itoa(it.Number) }>
								for _, v := range it.Verdicts {
									<button type="button" role="radio" class={ "t-" + v.Tone } data-verdict={ v.ID } aria-checked={ strconv.FormatBool(v.Checked) } tabindex={ tabIndex(v.Focus) }>{ v.Label }</button>
								}
							</span>
						}
						if it.Pickable {
							<button class="btn pick-btn" type="button" aria-pressed={ strconv.FormatBool(it.Picked) } data-pick>
								if it.Picked {
									Picked
								} else {
									Pick
								}
							</button>
						}
						<button class="link-btn note-btn" type="button" data-note-toggle>
							if it.Note != "" {
								Edit note
							} else {
								Add a note
							}
						</button>
					</span>
				}
			</div>
			<h3 { edit(it.EditTitle)... }>
				<svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
				if it.Numbered {
					<span class="num">{ strconv.Itoa(it.Number) }</span>
				}
				{ it.Title }
			</h3>
			if it.Summary != "" {
				<p class="one-line" { edit(it.EditSummary)... }>{ it.Summary }</p>
			}
		</summary>
		<div class="item-body">
			if it.Notes {
				<div class="note" data-note-wrap hidden?={ it.Note == "" }>
					<label for={ "note-" + it.ID }>Your note on { strconv.Itoa(it.Number) }</label>
					<textarea id={ "note-" + it.ID } data-note={ it.ID } rows="2" placeholder="Changes, conditions, or why not">{ it.Note }</textarea>
				</div>
			}
			<dl class="facets">
				for _, f := range it.Facets {
					<div class={ "facet", templ.KV("risk", f.Risk) }>
						<dt>{ f.Label }</dt>
						<dd { edit(f.Edit)... }>
							@templ.Raw(f.HTML)
						</dd>
					</div>
				}
				if len(it.DependsOn) > 0 {
					<div class="facet">
						<dt>Depends on</dt>
						<dd>
							<p>
								for _, d := range it.DependsOn {
									<a class="dep" href={ templ.URL("#" + d.ID) }>{ strconv.Itoa(d.Number) }</a>
								}
							</p>
						</dd>
					</div>
				}
			</dl>
		</div>
	</details>
}

templ chip(c Chip) {
	if c.Tone == "owner" {
		<span class="owner" title={ c.Label }><span class="sr">{ c.Label + ": " }</span>{ c.Text }</span>
	} else {
		<span class={ "chip", "t-" + c.Tone } title={ c.Label }>{ c.Text }</span>
	}
}

templ rowsBoard(b *BoardView) {
	<div class="part rows">
		for _, it := range b.Items {
			if len(it.Facets) > 0 {
				<details class="row" id={ it.ID }>
					<summary>
						<div>
							<b { edit(it.EditTitle)... }>{ it.Title }</b>
							if it.Summary != "" {
								<p { edit(it.EditSummary)... }>{ it.Summary }</p>
							}
						</div>
						<span class="row-chips">
							for _, c := range it.Chips {
								@chip(c)
							}
						</span>
						<svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
					</summary>
					<dl class="facets">
						for _, f := range it.Facets {
							<div class={ "facet", templ.KV("risk", f.Risk) }>
								<dt>{ f.Label }</dt>
								<dd { edit(f.Edit)... }>
									@templ.Raw(f.HTML)
								</dd>
							</div>
						}
					</dl>
				</details>
			} else {
				<div id={ it.ID }>
					<div>
						<b { edit(it.EditTitle)... }>{ it.Title }</b>
						if it.Summary != "" {
							<p { edit(it.EditSummary)... }>{ it.Summary }</p>
						}
					</div>
					<span class="row-chips">
						for _, c := range it.Chips {
							@chip(c)
						}
					</span>
				</div>
			}
		}
	</div>
}

templ pick(p *Page) {
	<div class="pick" id="pick" data-mode={ p.Mode } data-verdicts={ p.VerdictsJSON }>
		<b>{ p.Kind.Decision.Title }</b>
		<div>
			@templ.Raw(p.PickHTML)
		</div>
		if p.Choice != nil {
			<fieldset class="choice">
				<legend>{ p.Choice.Question }</legend>
				<div class="options">
					for _, o := range p.Choice.Options {
						<label>
							<input type="radio" name="dossier-choice" value={ o.ID } data-choice data-label={ o.Label } checked?={ o.Checked }/>
							<span><span class="opt">{ o.Label }</span>
								if o.Summary != "" {
									<span class="sum">{ o.Summary }</span>
								}
							</span>
						</label>
					}
				</div>
				<button type="button" class="clear" data-choice-clear hidden?={ !p.Choice.Chosen }>Clear the choice</button>
			</fieldset>
		}
		if p.ReplyExample != "" {
			<p class="example">For example <code>{ p.ReplyExample }</code></p>
		}
		<div class="reply" data-reply>{ p.Reply }</div>
		<div class="row">
			<button class="solid" type="button" data-copy-reply>Copy reply</button>
			<button type="button" data-copy-decisions>Copy decisions as JSON</button>
		</div>
	</div>
}
